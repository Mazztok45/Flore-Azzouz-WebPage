---
import Layout from "../layouts/Layout.astro";
import ScrollReveal from "../components/react/ScrollReveal.tsx";
import { getCollection } from "astro:content";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order
);
const testimonials = await getCollection("testimonials");
---

<Layout title="Flore Azzouz — Psychologue du travail">
  <section class="max-w-5xl mx-auto px-6 pt-20 pb-24 text-center">
    <ScrollReveal client:visible>
      <p class="uppercase tracking-widest text-sauge-dark text-sm mb-4">
        Psychologue du travail
      </p>
      <h1 class="font-serif text-4xl sm:text-5xl text-brun leading-tight">
        Prendre soin des personnes<br class="hidden sm:block" /> au cœur du travail
      </h1>
      <p class="mt-6 text-lg text-brun/80 max-w-2xl mx-auto">
        J'accompagne les individus, les équipes et les organisations pour construire
        un travail plus juste, plus sain et plus humain.
      </p>
      <a
        href="#contact"
        class="inline-block mt-8 bg-terracotta hover:bg-terracotta-dark text-creme px-8 py-3 rounded-full transition-colors"
      >
        Prendre rendez-vous
      </a>
    </ScrollReveal>
  </section>

  <section id="services" class="bg-sable">
    <div class="max-w-5xl mx-auto px-6 py-24">
      <ScrollReveal client:visible>
        <h2 class="font-serif text-3xl text-brun text-center mb-12">Mes services</h2>
      </ScrollReveal>
      <div class="grid gap-8 sm:grid-cols-3">
        {services.map((service, index) => (
          <ScrollReveal client:visible delay={index * 0.1}>
            <div class="bg-creme rounded-2xl p-8 h-full shadow-sm">
              <h3 class="font-serif text-xl text-brun mb-3">{service.data.title}</h3>
              <p class="text-brun/80 text-sm">{service.data.description}</p>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <section id="temoignages" class="max-w-5xl mx-auto px-6 py-24">
    <ScrollReveal client:visible>
      <h2 class="font-serif text-3xl text-brun text-center mb-12">Témoignages</h2>
    </ScrollReveal>
    <div class="grid gap-8 sm:grid-cols-2">
      {testimonials.map((testimonial, index) => (
        <ScrollReveal client:visible delay={index * 0.1}>
          <blockquote class="bg-sauge/10 border border-sauge/30 rounded-2xl p-8 h-full">
            <p class="text-brun/90 italic">&ldquo;{testimonial.data.quote}&rdquo;</p>
            <footer class="mt-4 text-sm text-brun/70">
              <span class="font-medium">{testimonial.data.name}</span>
              {testimonial.data.role && <span> — {testimonial.data.role}</span>}
            </footer>
          </blockquote>
        </ScrollReveal>
      ))}
    </div>
  </section>
</Layout>
