---
const links = [
  { href: "#services", label: "Services" },
  { href: "#temoignages", label: "Témoignages" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 bg-creme/90 backdrop-blur border-b border-sable">
  <nav class="max-w-5xl mx-auto flex items-center justify-between px-6 py-4">
    <a href={import.meta.env.BASE_URL} class="font-serif text-xl text-brun">Flore Azzouz</a>
    <ul class="flex gap-6 text-sm">
      {links.map((link) => (
        <li>
          <a href={link.href} class="hover:text-terracotta transition-colors">{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
