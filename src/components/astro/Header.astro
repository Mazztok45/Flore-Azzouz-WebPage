---
const base = import.meta.env.BASE_URL;

const links = [
  { href: base, label: "Accueil" },
  { href: `${base}particulier`, label: "Particulier" },
  { href: `${base}organisation`, label: "Organisation" },
  { href: `${base}about`, label: "À propos" },
  { href: `${base}blog`, label: "Blog" },
  { href: `${base}contact`, label: "Contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => href === base ? path === base : path.startsWith(href);
---

<header class="sticky top-0 z-50 bg-creme/90 backdrop-blur border-b border-sable">
  <nav class="max-w-5xl mx-auto flex items-center justify-between px-6 py-4">
    <a href={base} class="font-serif text-xl text-brun">Flore Azzouz</a>
    <ul class="flex flex-wrap gap-6 text-sm">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "hover:text-terracotta transition-colors",
              isActive(link.href) ? "text-terracotta font-medium" : "text-brun",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
